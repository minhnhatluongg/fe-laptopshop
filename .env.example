# =============================================================
# fe-LaptopShop — Environment variables
# Copy to .env.local for local overrides (gitignored).
# =============================================================

# Backend API base URL — must include /api/v1 suffix? No, leave as origin.
# We'll prepend the v1 path inside each service file.
VITE_API_BASE_URL=https://localhost:7299

# Public site title shown in headers/meta
VITE_SITE_NAME=LaptopShop

# Default theme: "light" or "dark"
VITE_DEFAULT_THEME=light

# Token storage key (rotate to invalidate all clients)
VITE_TOKEN_STORAGE_KEY=ls_auth_v1
